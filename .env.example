# Environment variables for the Swastik Enterprise app.
#
#   cp .env.example .env
#
# In development, .env is loaded automatically (dotenv, development group only;
# tests deliberately ignore it). In production, set these in the deploy
# environment instead: config/deploy.yml (env.clear) and .kamal/secrets.
#
# Uncommented keys are the site's own settings. Their values are the current
# defaults from app/models/catalog.rb, so replace them with the real details.
# A blank value falls back to the default. Commented keys are runtime knobs
# with safe defaults; uncomment only to change them.
#
# Company and site values are read once at boot: restart the app after
# changing them. Full reference: docs/seo.md and docs/analytics.md.

# ---------------------------------------------------------------------------
# Rails runtime
# ---------------------------------------------------------------------------

# Decrypts config/credentials.yml.enc. Locally it is read from config/master.key;
# production needs it (Kamal passes it from .kamal/secrets). Never commit it.
# RAILS_MASTER_KEY=

# RAILS_ENV=development
# RAILS_LOG_LEVEL=info          # production only (debug, info, warn, error)

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Production password for the "swastik_webapp" user (config/database.yml).
# SWASTIK_WEBAPP_DATABASE_PASSWORD=

# Optional: a full connection URL, which Rails merges into the primary
# database config, e.g. to point at a remote host.
# DATABASE_URL=postgres://swastik_webapp:password@localhost:5432/swastik_webapp_production

# ---------------------------------------------------------------------------
# Web server and background jobs
# ---------------------------------------------------------------------------

# PORT=3000
# RAILS_MAX_THREADS=3           # Puma threads (default 3) and DB pool size (default 5)
# WEB_CONCURRENCY=1             # Puma worker processes
# SOLID_QUEUE_IN_PUMA=true      # run background jobs inside Puma (set in deploy.yml)
# JOB_CONCURRENCY=1             # Solid Queue worker processes
# PIDFILE=tmp/pids/server.pid  # unset: Puma's own default

# ---------------------------------------------------------------------------
# Site URL and search engines
# ---------------------------------------------------------------------------

# Public origin used for canonical URLs, sitemap.xml, robots.txt, llms.txt and
# Open Graph tags. Required in production. Without it the request host is
# used, so leave it unset in development.
# SITE_URL=https://www.example.com

# Ownership verification codes (the content="" value of each meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Company details
# Shown in the navbar, footer, contact and about pages, quotation PDFs,
# structured data, llms.txt and the web app manifest.
# ---------------------------------------------------------------------------

COMPANY_NAME=Swastik Enterprise
COMPANY_LEGAL_NAME=Swastik Enterprise Steel & Structural Solutions
COMPANY_TAGLINE=Iron & steel, engineered for the long haul
COMPANY_SUMMARY=A steel manufacturing and supply house serving infrastructure, industrial, fabrication and construction teams across Central India.
COMPANY_ESTABLISHED=1988

# Contact
COMPANY_PHONE=+91 98261 00000
COMPANY_PHONE_ALT=+91 771 222 5151
COMPANY_EMAIL=sales@swastikenterprise.example
# Languages the sales desk answers in, comma-separated.
COMPANY_LANGUAGES=English,Hindi

# Address. The one-line address is built from these parts unless
# COMPANY_ADDRESS overrides it.
COMPANY_STREET=Industrial Area
COMPANY_CITY=Raipur
COMPANY_REGION=Chhattisgarh
COMPANY_REGION_CODE=IN-CT
COMPANY_POSTAL_CODE=492001
COMPANY_COUNTRY=India
COMPANY_COUNTRY_CODE=IN
# COMPANY_ADDRESS=Industrial Area, Raipur, Chhattisgarh 492001, India

# Map pin, for local search. Strongly recommended. Decimal degrees.
COMPANY_LATITUDE=
COMPANY_LONGITUDE=
# Defaults to a Google Maps search for the address. Prefer your Google
# Business Profile share link.
# COMPANY_MAP_URL=https://maps.app.goo.gl/...

# Opening hours: display text, then machine-readable hours for search engines
# (schema.org day names, comma-separated; 24-hour times).
COMPANY_HOURS=Mon – Sat, 9:30 am – 6:30 pm IST
COMPANY_OPEN_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday,Saturday
COMPANY_OPENS=09:30
COMPANY_CLOSES=18:30

# States served, comma-separated.
COMPANY_AREA_SERVED=Chhattisgarh,Madhya Pradesh,Maharashtra,Odisha,Jharkhand,Uttar Pradesh

# Social profiles. Leave YouTube/X blank to hide them. A network's bare home
# page (e.g. https://www.linkedin.com/) shows in the footer but is left out of
# search-engine data; use the full profile URL.
COMPANY_LINKEDIN_URL=https://www.linkedin.com/
COMPANY_INSTAGRAM_URL=https://www.instagram.com/
COMPANY_FACEBOOK_URL=https://www.facebook.com/
COMPANY_YOUTUBE_URL=
COMPANY_X_URL=
