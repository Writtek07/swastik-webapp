<% content_for :title, "Sign in · #{Catalog::COMPANY[:name]}" %>

<p class="micro">Admin console</p>
<h2 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.025em] text-ink-950">Sign in</h2>
<p class="mt-2 text-sm text-ink-500">Use the email and password your administrator set up for you.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
  <label class="field">
    <span>Email</span>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@swastik.example" %>
  </label>

  <label class="field">
    <span>Password</span>
    <%= f.password_field :password, autocomplete: "current-password", required: true, placeholder: "••••••••" %>
  </label>

  <% if devise_mapping.rememberable? %>
    <label class="flex cursor-pointer items-center gap-2.5 text-sm text-ink-600">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded-[2px] border-ink-900/20 accent-ember-500" %>
      Keep me signed in on this device
    </label>
  <% end %>

  <%= f.button type: "submit", class: "btn-primary w-full" do %>
    Sign in <%= icon "arrow-right", class: "h-4 w-4" %>
  <% end %>
<% end %>
