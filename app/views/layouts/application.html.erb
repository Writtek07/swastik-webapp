<!DOCTYPE html>
<html lang="en-IN" class="scroll-pt-24">
  <head>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-TWRKT9LB"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <title><%= content_for(:title) || page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Catalog::COMPANY[:name] %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0b0e14">
    <%= render "shared/seo_meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Decides before first paint whether the intro plays, so the page never
        flashes underneath it. Once per session, never under reduced motion,
        and a failsafe drops the class if the JavaScript bundle never runs. %>
    <script>
      (function () {
        try {
          var root = document.documentElement;
          if (sessionStorage.getItem("swastik:intro-seen")) return;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          root.classList.add("is-preloading");
          window.__introFailsafe = setTimeout(function () { root.classList.remove("is-preloading"); }, 6000);
        } catch (e) {}
      })();
    </script>

    <%= yield :head %>

    <%= render "shared/favicons" %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap">

    <%# Only the compiled Tailwind bundle is browser-ready; the raw sources in
        app/assets/stylesheets are inputs to the build, not servable stylesheets. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body
    class="grain min-h-screen"
    data-controller="video-modal smooth-scroll pointer scroll-instrument"
    data-action="keydown.esc@window->video-modal#close"
  >
    <%= render "shared/preloader" %>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[3px] focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-xs focus:font-bold focus:uppercase focus:tracking-widest focus:text-white">
      Skip to content
    </a>

    <%# Scroll progress rail. Decorative, so it is hidden from assistive tech. %>
    <div class="progress-rail" aria-hidden="true">
      <div class="progress-rail__bar" data-scroll-instrument-target="bar"></div>
    </div>

    <%= render "shared/navbar" %>

    <main id="main" class="relative z-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/analytics_events" %>
    <%= render "shared/video_modal" %>

    <%# Section readout — the "instrumented" signature of the page. Decorative:
        it restates the section the user is already looking at, so it is hidden
        from assistive tech rather than announced on every frame. %>
    <div class="section-readout" aria-hidden="true">
      <span class="section-readout__index" data-scroll-instrument-target="readoutIndex">01 / 01</span>
      <span class="section-readout__track">
        <span class="section-readout__thumb" data-scroll-instrument-target="readoutThumb"></span>
      </span>
      <span class="section-readout__label" data-scroll-instrument-target="readoutLabel"></span>
    </div>
  </body>
</html>
