<aside class="admin-sidebar">
  <div class="flex items-center justify-between gap-3 border-b border-white/10 px-5 py-5">
    <%= link_to admin_root_path, class: "flex items-center gap-3" do %>
      <%= brand_mark css: "h-9 w-auto shrink-0" %>
      <span class="leading-tight">
        <span class="block font-display text-sm font-extrabold tracking-tight text-white"><%= Catalog::COMPANY[:name] %></span>
        <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-ink-500">Back office</span>
      </span>
    <% end %>
  </div>

  <nav class="flex gap-1 overflow-x-auto px-3 py-3 lg:flex-1 lg:flex-col lg:py-5" aria-label="Admin">
    <%= admin_nav_link "Overview", admin_root_path, "grid", active: controller_name == "dashboard" %>
    <%= admin_nav_link "Daily prices", admin_daily_prices_path, "calendar", active: controller_name == "daily_prices" %>
    <%= admin_nav_link "Gauge prices", admin_guage_prices_path, "ruler", active: controller_name.start_with?("guage_") %>
    <%= admin_nav_link "Products", admin_products_path, "layers", active: controller_name == "products" %>
    <%= admin_nav_link "Enquiries", admin_enquiries_path, "mail", active: controller_name == "enquiries" %>
    <% if admin_can?(:staff) %>
      <%= admin_nav_link "Staff", admin_staff_path, "users", active: controller_name == "staff" %>
    <% end %>
    <%= admin_nav_link "Settings", admin_settings_path, "sliders", active: controller_name == "settings" %>
  </nav>

  <div class="hidden border-t border-white/10 px-5 py-4 lg:block">
    <div class="flex items-center gap-3">
      <%= admin_avatar current_admin, size: "h-9 w-9 text-[11px]" %>
      <div class="min-w-0 flex-1">
        <p class="truncate text-[13px] font-semibold text-white"><%= current_admin.display_name %></p>
        <p class="truncate text-[11px] text-ink-500"><%= current_admin.role.humanize %> · <%= current_admin.email %></p>
      </div>
    </div>
    <%= button_to destroy_admin_session_path, method: :delete, class: "mt-4 flex w-full items-center justify-center gap-2 rounded-[3px] border border-white/10 px-3 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-ink-400 transition-colors hover:border-white/25 hover:text-white" do %>
      <%= icon "arrow-left", class: "h-3.5 w-3.5" %> Sign out
    <% end %>
  </div>
</aside>
