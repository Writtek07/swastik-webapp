<header class="flex items-center justify-between gap-4 border-b border-ink-900/10 bg-white/70 px-5 py-3 backdrop-blur sm:px-8 lg:px-10">
  <p class="flex items-center gap-2 text-xs font-semibold text-ink-500">
    <%= icon "clock", class: "h-3.5 w-3.5" %>
    <%= l Date.current, format: "%A, %-d %B %Y" %>
  </p>

  <div class="flex items-center gap-3 lg:hidden">
    <%= admin_avatar current_admin %>
    <%= button_to "Sign out", destroy_admin_session_path, method: :delete, class: "text-[11px] font-bold uppercase tracking-[0.14em] text-ink-500 hover:text-ink-900" %>
  </div>
  <p class="hidden text-xs text-ink-500 lg:block">
    Signed in as <span class="font-semibold text-ink-800"><%= current_admin.display_name %></span>
  </p>
</header>
