<% content_for :title, "Enquiry from #{@enquiry.name} · Admin" %>

<%= link_to admin_enquiries_path, class: "inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.14em] text-ink-500 hover:text-ink-900" do %>
  <%= icon "arrow-left", class: "h-3.5 w-3.5" %> Enquiries
<% end %>
<div class="mt-3 flex flex-wrap items-center gap-3">
  <h1 class="admin-title"><%= @enquiry.name %></h1>
  <%= enquiry_status_pill @enquiry %>
</div>
<p class="mt-2 text-sm text-ink-500">
  <%= @enquiry.company.presence || "No company given" %> · received <%= l @enquiry.created_at, format: "%-d %b %Y, %H:%M" %>
</p>

<div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
  <section class="admin-card">
    <div class="admin-card__head">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-ink-950">Message</h2>
    </div>
    <div class="whitespace-pre-line px-5 py-5 text-sm leading-6 text-ink-800 sm:px-6"><%= @enquiry.message %></div>
  </section>

  <section class="admin-card self-start">
    <div class="admin-card__head">
      <h2 class="font-display text-lg font-extrabold tracking-tight text-ink-950">Details</h2>
    </div>
    <dl class="divide-y divide-ink-900/[0.06] px-5 sm:px-6">
      <% [
           [ "Email", mail_to(@enquiry.email, class: "hover:text-ember-600") ],
           [ "Phone", @enquiry.phone.present? ? link_to(@enquiry.phone, "tel:#{@enquiry.phone.delete(' ')}", class: "hover:text-ember-600") : "—" ],
           [ "Product", @enquiry.product_name ],
           [ "Quantity", @enquiry.quantity.presence || "—" ],
           [ "Deliver to", @enquiry.delivery_location.presence || "—" ]
         ].each do |label, value| %>
        <div class="flex items-start justify-between gap-6 py-3.5">
          <dt class="text-[10px] font-bold uppercase tracking-[0.18em] text-ink-500"><%= label %></dt>
          <dd class="text-right text-sm font-semibold text-ink-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>
</div>
