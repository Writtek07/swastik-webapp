<%# Sheared plate stack with a cut corner. %>
<svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Steel sheets and plates">
  <defs>
    <linearGradient id="plate-top" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#8791a3" stop-opacity="0.5"/>
    </linearGradient>
  </defs>

  <% [ 0, 20, 40 ].each_with_index do |offset, i| %>
    <g transform="translate(0 <%= offset %>)" opacity="<%= 1 - (i * 0.2) %>">
      <path d="M44 62 L262 34 L288 52 L70 80 Z" fill="url(#plate-top)"/>
      <path d="M44 62 L70 80 L70 92 L44 74 Z" fill="#4d5666" fill-opacity="0.85"/>
      <path d="M70 80 L288 52 L288 64 L70 92 Z" fill="#667085" fill-opacity="0.7"/>
    </g>
  <% end %>

  <%# Thickness callout %>
  <g stroke="#f95711" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.85">
    <path d="M30 62 L30 102"/>
    <path d="M24 62 L36 62M24 102 L36 102"/>
  </g>
  <text x="16" y="86" fill="#ffa971" font-size="9" font-family="monospace" transform="rotate(-90 16 86)">t</text>
</svg>
