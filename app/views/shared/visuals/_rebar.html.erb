<%# Deformed TMT rebar bundle with rib pattern. %>
<svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="TMT reinforcement bars">
  <defs>
    <linearGradient id="rebar-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="55%" stop-color="#b3bac7" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#3a4250" stop-opacity="0.95"/>
    </linearGradient>
    <pattern id="rebar-ribs" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(28)">
      <rect width="7" height="18" fill="#0b0e14" fill-opacity="0.35"/>
    </pattern>
  </defs>

  <% [ 0, 34, 68 ].each_with_index do |offset, i| %>
    <g transform="translate(0 <%= offset %>)" opacity="<%= 1 - (i * 0.2) %>">
      <rect x="26" y="52" width="268" height="22" rx="11" fill="url(#rebar-body)"/>
      <rect x="26" y="52" width="268" height="22" rx="11" fill="url(#rebar-ribs)"/>
      <circle cx="26" cy="63" r="11" fill="#8791a3" fill-opacity="0.85"/>
      <circle cx="294" cy="63" r="11" fill="#4d5666" fill-opacity="0.9"/>
    </g>
  <% end %>

  <%# Diameter callout %>
  <g stroke="#f95711" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.85">
    <path d="M14 52 L14 74"/>
    <path d="M8 52 L20 52M8 74 L20 74"/>
  </g>
  <text x="4" y="46" fill="#ffa971" font-size="9" font-family="monospace">Ø</text>
</svg>
