<%# Stacked flat bars in perspective. %>
<svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mild steel flat bars">
  <defs>
    <linearGradient id="flat-top" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#8791a3" stop-opacity="0.5"/>
    </linearGradient>
  </defs>

  <% [ 0, 26, 52, 78 ].each_with_index do |offset, i| %>
    <g transform="translate(0 <%= offset %>)" opacity="<%= 1 - (i * 0.16) %>">
      <path d="M40 46 L250 20 L286 40 L76 66 Z" fill="url(#flat-top)"/>
      <path d="M40 46 L76 66 L76 78 L40 58 Z" fill="#4d5666" fill-opacity="0.85"/>
      <path d="M76 66 L286 40 L286 52 L76 78 Z" fill="#667085" fill-opacity="0.7"/>
    </g>
  <% end %>

  <%# Width dimension %>
  <g stroke="#f95711" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.85">
    <path d="M40 30 L286 4"/>
    <path d="M40 24 L40 36M286 -2 L286 10"/>
  </g>
  <text x="150" y="14" fill="#ffa971" font-size="9" font-family="monospace">W</text>
</svg>
