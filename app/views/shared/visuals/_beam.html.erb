<%# I-beam / column section drawn in isometric projection. %>
<svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Parallel flange beam section">
  <defs>
    <linearGradient id="beam-face" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#8791a3" stop-opacity="0.55"/>
    </linearGradient>
    <linearGradient id="beam-side" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#b3bac7" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#3a4250" stop-opacity="0.9"/>
    </linearGradient>
  </defs>

  <%# Top flange %>
  <path d="M40 62 L200 30 L280 62 L120 94 Z" fill="url(#beam-face)"/>
  <path d="M40 62 L120 94 L120 108 L40 76 Z" fill="url(#beam-side)"/>
  <path d="M120 94 L280 62 L280 76 L120 108 Z" fill="#667085" fill-opacity="0.75"/>

  <%# Web %>
  <path d="M104 100 L136 94 L136 168 L104 174 Z" fill="url(#beam-face)"/>
  <path d="M136 94 L152 97 L152 171 L136 168 Z" fill="#4d5666" fill-opacity="0.85"/>

  <%# Bottom flange %>
  <path d="M40 168 L200 136 L280 168 L120 200 Z" fill="url(#beam-face)"/>
  <path d="M40 168 L120 200 L120 214 L40 182 Z" fill="url(#beam-side)"/>
  <path d="M120 200 L280 168 L280 182 L120 214 Z" fill="#667085" fill-opacity="0.75"/>

  <%# Dimension lines %>
  <g stroke="#f95711" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.85">
    <path d="M28 62 L28 182"/>
    <path d="M22 62 L34 62M22 182 L34 182"/>
  </g>
  <text x="14" y="128" fill="#ffa971" font-size="9" font-family="monospace" transform="rotate(-90 14 128)">H</text>
</svg>
