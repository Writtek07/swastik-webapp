<%# Hollow section pipe, end-on with a cutaway. %>
<svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Steel pipe section">
  <defs>
    <linearGradient id="pipe-wall" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#667085" stop-opacity="0.65"/>
    </linearGradient>
  </defs>

  <%# Pipe body in perspective %>
  <path d="M96 44 L232 30 L232 176 L96 190 Z" fill="url(#pipe-wall)" fill-opacity="0.35"/>
  <path d="M96 44 L232 30 L232 176 L96 190 Z" stroke="#b3bac7" stroke-opacity="0.5"/>

  <%# End-on annulus %>
  <ellipse cx="96" cy="117" rx="34" ry="73" fill="url(#pipe-wall)"/>
  <ellipse cx="96" cy="117" rx="21" ry="46" fill="#0b0e14" fill-opacity="0.85"/>
  <ellipse cx="96" cy="117" rx="21" ry="46" stroke="#f95711" stroke-opacity="0.5" stroke-dasharray="4 4"/>

  <%# Wall thickness callout %>
  <g stroke="#f95711" stroke-width="1.2" opacity="0.9">
    <path d="M62 117 L75 117"/>
    <path d="M62 111 L62 123M75 111 L75 123"/>
  </g>
  <text x="44" y="106" fill="#ffa971" font-size="9" font-family="monospace">t</text>
</svg>
