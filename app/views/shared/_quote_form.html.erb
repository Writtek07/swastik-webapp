<%#
  "Get your quote": product → size → quantity, posted to QuotesController#create,
  which answers with a PDF download (so Turbo is off for the form).
  Locals: quotable ({ product => [sizes] } from QuoteCalculator.quotable)
%>
<div id="quote" class="reveal mt-16 scroll-mt-24 grid gap-10 rounded-[4px] border border-ink-900/10 bg-white p-6 sm:p-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 dark:border-white/10 dark:bg-ink-950" data-reveal-target="item">
  <div>
    <p class="kicker">Get your quote</p>
    <h3 class="mt-4 font-display text-2xl font-extrabold tracking-[-0.025em] sm:text-3xl">Price it in seconds.</h3>
    <p class="body-text mt-4">
      Pick a product and size, enter the quantity and download a quotation built on today's basic rate and
      the current gauge difference — loading and GST included.
    </p>
  </div>

  <% if quotable.empty? %>
    <div class="flex flex-col justify-center gap-5">
      <p class="body-text">Online quotes are paused while this season's gauge prices are being updated.</p>
      <%= link_to contact_path(anchor: "enquiry"), class: "btn-dark self-start" do %>
        Send an enquiry instead
        <%= icon "arrow-right" %>
      <% end %>
    </div>
  <% else %>
    <%= form_with scope: :quote, url: quotes_path, class: "space-y-5",
          data: { turbo: false, controller: "quote",
                  quote_sizes_value: quotable.to_h { |product, sizes| [ product.id, sizes ] }.to_json,
                  action: "submit->quote#submit" } do |form| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="field sm:col-span-2">
          <span>Product *</span>
          <%= form.select :product_id, quotable.keys.map { |product| [ product.title, product.id, { data: { slug: product.slug } } ] },
                { include_blank: "Select a product" },
                required: true, data: { quote_target: "product", action: "change->quote#productChanged" } %>
        </label>
        <label class="field">
          <span>Size *</span>
          <%= form.select :size, [], { include_blank: "Select a product first" },
                required: true, disabled: true, data: { quote_target: "size" } %>
        </label>
        <label class="field">
          <span>Quantity (MT) *</span>
          <%= form.number_field :quantity, required: true, min: 0.001, max: QuoteCalculator::MAX_QUANTITY,
                step: 0.001, placeholder: "e.g. 10", inputmode: "decimal" %>
        </label>
      </div>

      <div class="flex flex-col gap-4 border-t border-ink-900/10 pt-5 sm:flex-row sm:items-center sm:justify-between dark:border-white/10">
        <p class="text-xs leading-5 text-ink-500 dark:text-ink-400">
          Indicative quotation, valid for today's rates. Final pricing is confirmed on the sales order.
        </p>
        <button type="submit" class="btn-primary shrink-0" data-quote-target="submit">
          <span data-quote-target="submitLabel">Download quote</span>
          <%= icon "arrow-down" %>
        </button>
      </div>
    <% end %>
  <% end %>
</div>
