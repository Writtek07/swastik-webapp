<%#
  Page hero used by every inner page.
  Locals: kicker, title, lede, breadcrumb (array of [label, path]), visual (optional)
%>
<% breadcrumb ||= [] %>
<% visual ||= nil %>
<% lede ||= nil %>
<section class="relative overflow-hidden border-b border-ink-900/10 bg-ink-950 text-white dark:border-white/10">
  <div class="blueprint-grid absolute inset-0 opacity-40"></div>
  <div class="absolute -left-24 top-0 h-80 w-80 rounded-full bg-ember-600/25 blur-[100px]"></div>
  <div class="absolute right-0 top-1/3 h-72 w-72 rounded-full bg-ember-400/10 blur-[90px]"></div>

  <div class="shell relative grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_.85fr] lg:items-center lg:py-24">
    <div>
      <% if breadcrumb.any? %>
        <nav class="breadcrumb mb-8 text-ink-400" aria-label="Breadcrumb">
          <%= link_to "Home", root_path %>
          <% breadcrumb.each do |label, path| %>
            <%= icon "chevron-right", class: "h-3 w-3" %>
            <% if path %>
              <%= link_to label, path %>
            <% else %>
              <span class="text-ember-400"><%= label %></span>
            <% end %>
          <% end %>
        </nav>
      <% end %>

      <p class="kicker text-ember-400"><%= kicker %></p>
      <h1 class="display mt-6 max-w-3xl"><%= title %></h1>
      <% if lede.present? %>
        <p class="mt-7 max-w-2xl text-base leading-8 text-ink-300 sm:text-lg"><%= lede %></p>
      <% end %>
      <% if block_given? %>
        <div class="mt-9"><%= yield %></div>
      <% end %>
    </div>

    <% if visual.present? %>
      <div class="relative">
        <%= visual %>
      </div>
    <% end %>
  </div>
</section>
